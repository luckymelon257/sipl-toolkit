{
  "name": "sipl-toolkit",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "pretest": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "c8 --check-coverage --lines 80 --reporter text-summary --include \".test-build/src/**\" node --test .test-build/tests/",
    "prepack": "npm run build"
  },
  "keywords": [
    "sipl",
    "semantics",
    "fixpoint",
    "verification",
    "theory-of-programming"
  ],
  "author": "Bogdan Kravchuk",
  "license": "MIT",
  "description": "SIPL and SIPL-R toolkit: parser, semantic terms, least-fixpoint approximations and a loop correctness assistant",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "bin": {
    "sipl": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammar",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
